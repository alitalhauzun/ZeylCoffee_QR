  <script>
    // Toast bildirim göster
    function showToast(message, isError = false) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = 'toast' + (isError ? ' error' : '');
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    // Menüyü güncelle - sayfayı yeniler ve kullanıcıya onay gösterir
    function refreshMenu() {
      showToast('✅ Menü başarıyla güncellendi! Müşteriler yeni menüyü görecek.');
      setTimeout(() => {
        location.reload();
      }, 1500);
    }
    function updateItem(itemId, field, value) {
      const data = { id: itemId };
      data[field] = value;

      fetch('/admin/update-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            console.log('Güncellendi');
          }
        });
    }


    function saveItemPrice(itemId) {
      const input = document.getElementById('price-' + itemId);
      if (!input) return;

      const value = input.value;

      if (value === '' || value === null) {
        alert('Lütfen geçerli bir fiyat girin.');
        return;
      }

      updateItem(itemId, 'price', value);
    }

    function deleteItem(itemId) {
      if (!confirm('Bu ürünü silmek istediğinizden emin misiniz?')) return;

      fetch('/admin/delete-item', {
        method: 'POST',
